# Copie para .env e ajuste
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=agroclima
POSTGRES_USER=agroclima
POSTGRES_PASSWORD=troque-esta-palavra-passe

# Google Earth Engine — projecto Cloud registado para Earth Engine
GEE_PROJECT=o-seu-projecto-gcp
# Em Docker a chave é montada a partir de ./secrets/gee-key.json (ver docker-compose.yml)

# Limites administrativos (alternativa: carregar GeoJSON oficial com load_regions --file)
GEE_ADMIN_L1_ASSET=FAO/GAUL/2015/level1
GEE_ADMIN_L2_ASSET=FAO/GAUL/2015/level2
GEE_COUNTRY_FIELD=ADM0_NAME
GEE_COUNTRY_NAME=Guinea-Bissau

# Períodos de referência
RAIN_BASELINE_START=1991
RAIN_BASELINE_END=2020
VEG_BASELINE_START=2001
VEG_BASELINE_END=2020
